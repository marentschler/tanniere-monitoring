# Everything that gets executed or parsed on the Linux server must keep LF
# endings, regardless of core.autocrlf on the Windows side. A CR in a shell
# script or .env file breaks in confusing ways.
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.py        text eol=lf
Caddyfile   text eol=lf
