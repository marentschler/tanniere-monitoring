SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUDRATE=19200
DEVICE_ID=smartsolar-01

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_KEEPALIVE=60

# Best-effort bridge settings for local Mosquitto -> remote/cloud broker.
# On read-only systems this queue is RAM-only and is lost on reboot.
BRIDGE_REMOTE_HOST=
BRIDGE_REMOTE_PORT=8883
BRIDGE_REMOTE_USERNAME=
BRIDGE_REMOTE_PASSWORD=
BRIDGE_TOPIC=victron/vedirect/#