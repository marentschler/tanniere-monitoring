SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUDRATE=19200
DEVICE_ID=smartsolar-01

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_KEEPALIVE=60

# SmartShunt Bluetooth GATT -> MQTT settings.
# Enable "Bluetooth GATT" on the shunt in VictronConnect. The service pairs the device
# automatically on start when no bond exists, so no manual pairing is needed.
SMARTSHUNT_DEVICE_ID=smartshunt-01
SMARTSHUNT_BT_ADDRESS=
# 6-digit VictronConnect PIN. Only used to pair when the bond is missing; the
# service re-pairs automatically on start, so this can stay set.
SMARTSHUNT_BT_PIN=
# Seconds between polls. The shunt allows one connection at a time, so the bridge
# disconnects between polls to leave it reachable from VictronConnect.
SMARTSHUNT_POLL_INTERVAL=30
SMARTSHUNT_SCAN_TIMEOUT=20

# Best-effort bridge settings for local Mosquitto -> remote/cloud broker.
# On read-only systems this queue is RAM-only and is lost on reboot.
BRIDGE_REMOTE_HOST=
BRIDGE_REMOTE_PORT=8883
BRIDGE_REMOTE_USERNAME=
BRIDGE_REMOTE_PASSWORD=
BRIDGE_TOPIC=victron/vedirect/#
BRIDGE_TOPIC_SMARTSHUNT=victron/smartshunt/#
