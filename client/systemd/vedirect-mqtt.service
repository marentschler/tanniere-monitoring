[Unit]
Description=Victron VE.Direct to MQTT bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/tanniere-monitoring-1/client
EnvironmentFile=/root/tanniere-monitoring-1/client/.env
ExecStart=/root/tanniere-monitoring-1/client/.venv/bin/python /root/tanniere-monitoring-1/client/src/vedirect_mqtt_bridge.py
Restart=always
RestartSec=5
User=root

# If the process hangs and stops heartbeating logs/IO, systemd can still restart it.
TimeoutStartSec=30
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target